# Variables de entorno.
#  - Local:      copia este archivo a ".env.local" y corre `vercel dev`.
#  - Producción: Vercel > Project > Settings > Environment Variables.
#
# NO subas .env.local ni valores reales al repo.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-SECRETA

# Sal para el hash de IP (anti-abuso). Pon cualquier texto largo y aleatorio.
IP_SALT=cambia-esto-por-algo-largo-y-unico

# Secreto de la limpieza automática de 30 días (/api/purge). Texto aleatorio de 32+ caracteres.
# Vercel Cron lo envía solo como "Authorization: Bearer ...". Sin él, no se borra nada.
CRON_SECRET=cambia-esto-por-otro-texto-largo-y-aleatorio

# ---------- Comunidad JUMP (/jump/comunidad/) ----------
# JUMP tiene su PROPIO proyecto de Supabase (aparte del de arriba, que es de La Aurora Escucha).
# Estas tres NO tienen respaldo en las de arriba: si falta una, JUMP no funciona (así nunca cae en la base de La Aurora).
# Project URL, anon key y service_role key del proyecto de JUMP (Settings > API).
JUMP_SUPABASE_URL=https://TU-PROYECTO-JUMP.supabase.co
JUMP_SUPABASE_ANON_KEY=tu-anon-key-publica-de-jump
JUMP_SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-jump-SECRETA
# Además: el Project URL de JUMP va una vez en scripts/csp.mjs (JUMP_SUPABASE_HOST), y luego `node scripts/csp.mjs`.

# Secreto para firmar el "state" de Zoom y cifrar los tokens de Zoom en la base. Texto aleatorio de 32+ caracteres.
# Si se cambia, la cuenta de Zoom conectada deja de servir y hay que volver a conectarla en Ajustes.
JUMP_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas

# App de Zoom (OAuth "General app", creada dentro de la cuenta de Zoom de JUMP). Ver docs/jump/PUESTA-EN-MARCHA.md.
ZOOM_CLIENT_ID=tu-client-id-de-zoom
ZOOM_CLIENT_SECRET=tu-client-secret-de-zoom-SECRETO
# "Secret Token" de la sección de eventos (webhooks) de la app de Zoom: valida el aviso de desautorización.
ZOOM_WEBHOOK_SECRET=tu-secret-token-de-zoom-SECRETO

# Dirección pública del sitio, sin barra al final. Zoom vuelve a ${JUMP_PUBLIC_URL}/api/jump-zoom-callback.
JUMP_PUBLIC_URL=https://www.laauroraescucha.com
